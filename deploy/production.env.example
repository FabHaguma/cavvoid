# Private VPS runtime configuration. Copy to deploy/production.env, chmod 600.
# CAVVOID_RELEASE should identify the pushed commit, e.g. its full Git SHA.
CAVVOID_RELEASE=replace-with-pushed-git-commit
# Confirm this against the running Gatekeeper before rollout.
GATEKEEPER_URL=https://login.haguma.com
# Separate CavVoid ingress proof. Never use Gatekeeper's PROXY_AUTH_SECRET here.
CAVVOID_INGRESS_SECRET=replace-with-64-lowercase-hex-characters
MAX_TEXT_BYTES=102400
MAX_FILE_BYTES=104857600
STORAGE_QUOTA_BYTES=2147483648
