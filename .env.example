# Local foundation only. Run npm run setup:local to generate private demo settings.
APP_ORIGIN=http://localhost:3000
GATEKEEPER_URL=http://localhost:4000
GATEKEEPER_PROXY_SECRET=replace-with-at-least-32-random-characters
GATEKEEPER_TIMEOUT_MS=5000
DATABASE_PATH=./backend/data/cavvoid.sqlite
OWNER_DISPLAY_NAME=Fabrice
MAX_TEXT_BYTES=102400
MAX_FILE_BYTES=104857600
STORAGE_QUOTA_BYTES=2147483648
# Private storage; defaults to a files/ directory beside DATABASE_PATH.
FILES_PATH=./backend/data/files

# Optional: use the existing Gatekeeper source with isolated local demo data.
# Set by npm run setup:local. Remove to use an already-running local Gatekeeper.
LOCAL_GATEKEEPER_REPO=
